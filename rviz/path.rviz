Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RobotModel1
        - /RobotPath1
      Splitter Ratio: 0.5
    Tree Height: 549
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.3
      Cell Size: 0.5
      Plane: XY
      Plane Cell Count: 20
      Color: 120; 120; 130
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Name: RobotPath
      Enabled: true
      Alpha: 1
      Buffer Length: 1
      Color: 255; 30; 30
      Line Style: Lines
      Line Width: 0.05
      Topic:
        Value: /robot_path
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: false
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3
      Focal Point:
        X: 0.5
        Y: 0.5
        Z: 0.0
      Pitch: 1.0
      Yaw: 0.0
      Target Frame: <Fixed Frame>
    Saved: ~
  Value: true
Window Geometry:
  Height: 1000
  Width: 1400
  X: 20
  Y: 20
